        "6": {
            "key": [],
            "keysecondary": [],
            "comment": "世界观",
            "content": "# 世界设定-玄机大陆\nworld_setting:\n  name: 玄机大陆\n  features:\n    - 充满机遇与神秘力量\n    - 修仙者与凡人共存\n    - 妖兽遍布各处\n  population_ratio:\n    normal_people: 99%\n    cultivators: 1%\n\n# 修仙体系\ncultivation_system:\n  main_types:\n    - 仙法: [剑术, 阵法, 炼器, 炼药, 锻体, 唤兽]\n    - 神魂: 需要天赋和秘诀配合\n  levels:\n    - 先天练气\n    - 黄庭筑基  \n    - 培元凝气\n    - 仙气朝元\n    - 三花聚顶\n    - 阴阳交汇\n    - 瑞变灵寂\n    - 道法自然\n    - 羽化升仙\n  sub_levels: [初期, 中期, 后期]\n\n# 主要势力\nmajor_powers:\n  cultivation_sects:\n    - name: 天师府\n      status: 三大门派之一\n      features: 剑术和符阵见长\n    - name: 璇玑阁\n      status: 三大门派之一\n    - name: 百花门\n      status: 三大门派之一\n  political_power:\n    - name: 圣天城圣天皇族\n      status: 统治者\n      control: [政治, 经济, 军事, 文化]\n\n# 地理位置\nlocations:\n  - name: 金陵城\n    type: 边境小城\n    features: \n      - 资源稀少\n      - 修仙者较少\n      - 设有慎刑司\n  - name: 圣天城\n    type: 皇族所在地\n    status: 政治中心\n\n# 重要组织\norganizations:\n  - name: 慎刑司\n    location: 金陵城\n    leader: 徐正峰\n    purpose: 捕捉妖兽维护治安\n    status: 中立势力\n    structure:\n      - 司主: 徐正峰\n      - 影刃: 特殊职位(共5位)\n    features:\n      - 不隶属任何势力\n      - 独立于城主府\n      - 拥有特殊权力\n\n# 核心人物关系\nrelationships:\n  王野:\n    身份: 天师府弟子\n    师父: 楚雄之(天师府长老)\n    妻子: 楚清仪\n    父亲: 王老五\n    职位: 慎刑司第五影刃\n  \n  楚清仪:\n    身份: 天师府府主之女\n    父亲: 楚天南(府主)\n    丈夫: 王野\n    修炼功法: 大道忘情诀\n\n  王老五:\n    身份: 普通农民\n    儿子: 王野\n    居住地: 金陵城",
